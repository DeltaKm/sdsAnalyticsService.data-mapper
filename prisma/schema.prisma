generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

/// -------------------
/// Ingress events
/// -------------------

enum IngressSource {
  POS
  ERP
}

model IngressEvent {
  id        String        @id @default(auto()) @map("_id") @db.ObjectId
  source    IngressSource
  payload   Json
  createdAt DateTime      @default(now())

  @@index([source, createdAt])
  @@map("ingress_events")
}

/// -------------------
/// Activity taxonomy
/// -------------------

model StoreGroup {
  id           String             @id @default(auto()) @map("_id") @db.ObjectId
  groupId      String             @unique
  name         String
  supervisorId String?
  metadata     Json?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  subgroups    StoreSubgroup[]
  stores       Store[]
}

model StoreSubgroup {
  id         String           @id @default(auto()) @map("_id") @db.ObjectId
  subgroupId String           @unique
  groupId    String
  name       String
  metadata   Json?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  group      StoreGroup       @relation(fields: [groupId], references: [groupId])
  stores     Store[]

  @@index([groupId])
}

model Store {
  id         String           @id @default(auto()) @map("_id") @db.ObjectId
  storeId    String
  tenantId   String
  groupId    String
  subgroupId String?
  name       String?
  status     String           @default("active")
  metadata   Json?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  group      StoreGroup       @relation(fields: [groupId], references: [groupId])
  subgroup   StoreSubgroup?   @relation(fields: [subgroupId], references: [subgroupId])
  tenant     Tenant           @relation(fields: [tenantId], references: [tenantId])

  @@unique([tenantId, storeId])
  @@index([groupId])
  @@index([subgroupId])
  @@index([tenantId, groupId])
}

model Tenant {
  id       String   @id @default(auto()) @map("_id") @db.ObjectId
  tenantId String   @unique
  name     String
  metadata Json?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  stores Store[]
}

